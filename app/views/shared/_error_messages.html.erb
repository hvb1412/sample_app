<% if object.errors.any? %>
  <div id="error_explanation">
    <div class="alert alert-danger">
      <%= t("shared.error_messages.the_form_contains") %>
      <% if I18n.locale == :en %>
        <%= pluralize object.errors.count, t("shared.error_messages.error") %>.
      <% else %>
        <%= t("shared.error_messages.error", count: object.errors.count) %>
      <% end %>
    </div>
    <ul>
      <% object.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
