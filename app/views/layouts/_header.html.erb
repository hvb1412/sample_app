<header class="navbar navbar-fixed-top navbar-inverse">
  <div class="container">
    <%= link_to t(".title"), "#", id: "logo" %>
    <nav>
      <ul class="nav navbar-nav navbar-right">
        <li><%= link_to t(".home"), root_path(locale: I18n.locale) %></li>
        <li><%= link_to t(".help"), help_path(locale: I18n.locale) %></li>
        <% if logged_in? %>
          <li><%= link_to t(".users"), users_path(locale: I18n.locale) %></li>
          <li class="dropdown">
            <%= link_to "#", class: "dropdown-toggle", "data-toggle": "dropdown" do %>
              <%= t(".account") %>
              <b class="caret"></b>
            <% end %>
            <ul class="dropdown-menu">
              <li><%= link_to t(".profile"), user_path(current_user, locale: I18n.locale) %></li>
              <li><%= link_to t(".settings"), edit_user_path(current_user, locale: I18n.locale) %></li>
              <li class="devider"></li>
              <li><%= link_to t(".logout"), logout_path(locale: I18n.locale), data: { turbo_method: :delete } %></li>
            </ul>
          </li>
        <% else %>
          <li><%= link_to t(".login"), login_path(locale: I18n.locale) %></li>
        <% end %>
        <li class="dropdown locale-dropdown">
          <a href="#"
              class="dropdown-toggle"
              data-toggle="dropdown"
              role="button">
            <%= I18n.locale.upcase %>
            <span class="caret"></span>
          </a>
          <ul class="dropdown-menu">
            <li><%= link_to Settings.available_locales.en.upcase, url_for(locale: :en) %></li>
            <li><%= link_to Settings.available_locales.ja.upcase, url_for(locale: :ja) %></li>
            <li><%= link_to Settings.available_locales.vi.upcase, url_for(locale: :vi) %></li>
          </ul>
        </li>
      </ul>
    </nav>
  </div>
</header>
