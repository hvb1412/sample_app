<% provide :title, t("users.edit.title") %>
<h1><%= t(".main_title") %></h1>
<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <%= render "form", submit_text: t(".save_changes") %>
    <div class="gravatar_edit">
      <%= gravatar_for @user %>
      <a href=<%= Settings.gravatar.emails %> target="_blank"><%= t(".change") %></a>
    </div>
  </div>
</div>
