<% provide :title, t(".title") %>
<h1><%= t(".title") %></h1>
<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <%= form_for :session, url: login_path(locale: I18n.locale) do |f| %>
      <%= f.label :email, t(".email") %>
      <%= f.email_field :email, class: "form-control" %>
      <%= f.label :password, t(".password") %>
      <%= link_to t(".forgot_password"), new_password_reset_path(locale: I18n.locale) %>
      <%= f.password_field :password, class: "form-control" %>
      <%= f.submit t(".log_in"), class: "btn btn-primary" %>
      <%= f.label :remember_me, t(".remember_me"), class: "checkbox inline" do %>
        <%= f.check_box :remember_me %>
        <span><%= t(".remember_on_device") %></span>
      <% end %>
    <% end %>
    <p><%= t(".new_user") %><%= link_to t(".sign_up_now"), signup_path(locale: I18n.locale) %></p>
  </div>
</div>
